{
  "name": "guardiao-da-agua-js",
  "version": "1.0.0",
  "description": "Guardião da Água - Educational Water Management Game",
  "main": "index.html",
  "scripts": {
    "start": "python3 -m http.server 3000 || python -m http.server 3000",
    "prestart": "npm run cache-bust",
    "pretest": "npm run cache-bust",
    "cache-bust": "node scripts/cache-bust.js",
    "test": "npm run lint && npm run test:unit && playwright test",
    "lint": "eslint .",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "screenshots": "node scripts/screenshot-buildings.js",
    "install-playwright": "playwright install"
  },
  "keywords": [
    "game",
    "education",
    "water-management",
    "babylonjs",
    "javascript"
  ],
  "author": "Kayquer",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
